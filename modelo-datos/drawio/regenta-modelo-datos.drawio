<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.3.6 Chrome/140.0.7339.249 Electron/38.8.0 Safari/537.36" version="29.3.6" pages="22">
  <diagram name="00 · Léeme" id="P7">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="B1" value="Modelo de datos de Regenta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F1A24;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="147 tablas · 15 microservicios · 3 patrones operativos.  Generado desde el DDL real y verificado contra PostgreSQL 16." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E7183;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="&lt;b&gt;Cómo está organizado este archivo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Las pestañas de abajo son las páginas. Las cinco primeras son &lt;b&gt;conceptuales&lt;/b&gt; —para entender el sistema— y las dieciséis siguientes son el &lt;b&gt;ER tabla por tabla&lt;/b&gt;, una por microservicio.&lt;br&gt;&lt;br&gt;&lt;b&gt;01 · Mapa de contextos&lt;/b&gt; — los 15 servicios, qué es REST y qué es evento.&lt;br&gt;&lt;b&gt;02 · Patrones operativos&lt;/b&gt; — Venta directa / Reserva / Comanda lado a lado.&lt;br&gt;&lt;b&gt;03 · Saga Ventas ↔ Inventario&lt;/b&gt; — cómo se descuenta stock sin transacción distribuida.&lt;br&gt;&lt;b&gt;04 · Mapa de eventos&lt;/b&gt; — quién publica qué y quién lo consume.&lt;br&gt;&lt;b&gt;05 · Referencias lógicas&lt;/b&gt; — los UUID que cruzan servicios sin FK física.&lt;br&gt;&lt;b&gt;06 a 21 · ER por servicio&lt;/b&gt; — todas las columnas, tipos, PK, FK y UQ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="&lt;b&gt;Cómo leer las tablas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada entidad es una tabla de drawio: cabecera con el nombre, y una fila por columna.&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria (en negrita) &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foránea real &amp;nbsp; &lt;b&gt;UQ&lt;/b&gt; restricción única&lt;br&gt;&lt;b&gt;?&lt;/b&gt; la columna admite NULL &amp;nbsp;&amp;nbsp; &lt;b&gt;⚙&lt;/b&gt; columna GENERATED por Postgres&lt;br&gt;&lt;br&gt;El color de la cabecera indica el patrón:&lt;br&gt;gris azulado = Core &amp;nbsp; ocre = Venta directa&lt;br&gt;verde azulado = Reserva &amp;nbsp; rojo = Comanda&lt;br&gt;&lt;br&gt;Las flechas dentro de una página son FK reales. &lt;b&gt;Ninguna flecha cruza de un servicio a otro&lt;/b&gt;: eso está en la página 05, con línea punteada." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="B5" value="&lt;b&gt;Este diagrama no se dibujó a mano: se generó leyendo el catálogo de PostgreSQL después de ejecutar el DDL.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los nombres, tipos, claves y relaciones son exactamente los de los scripts de sql/ — no puede haber divergencia entre el diagrama y la base.&lt;br&gt;Si cambias el DDL, se regenera; si cambias el diagrama a mano, el DDL manda.&lt;br&gt;&lt;br&gt;Verificado: 0 claves foráneas cruzando esquemas de servicios distintos · 0 tablas de negocio sin negocio_id · 2 constraints de exclusión anti-solape · 8 tablas particionadas por fecha." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="B6" value="&lt;b&gt;Cuatro servicios de este modelo son propuestas, no están en el scaffold dla arquitectura del proyecto&lt;/b&gt;&lt;br&gt;&lt;br&gt;servicio-clientes · servicio-alertas · servicio-caja · servicio-auditoria.&lt;br&gt;Los cuatro módulos SÍ están en la tabla de planes del documento de arquitectura, pero no tienen repositorio asignado. Ninguno puede alojarse dentro de Ventas: los cuatro son transversales a los tres patrones operativos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1220" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
