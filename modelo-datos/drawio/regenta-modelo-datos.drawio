          <mxGeometry x="40" y="30" width="1100" height="32" as="geometry" />
        </mxCell>
        <mxCell id="B70" value="No hay @Transactional que cubra dos servicios. La máquina de estados queda persistida en ventas.sagas y el stock apartado en inventario.reservas_stock." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E7183;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="B71" value="&lt;b&gt;ventas&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF1E4;strokeColor=#9A5709;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B72" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#4A5C6D;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="140" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B73" value="&lt;b&gt;inventario&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF1E4;strokeColor=#9A5709;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="140" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B74" value="PASO 1 · venta pasa de BORRADOR a PENDIENTE_STOCK&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;+ INSERT en outbox_eventos, en la MISMA transacción&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF1E4;strokeColor=#9A5709;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B75" value="&lt;b&gt;solicitar_reserva_stock&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#4A5C6D;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B76" value="PASO 2 · reservas_stock = ACTIVA&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;existencias.cantidad_reservada += n&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF1E4;strokeColor=#9A5709;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="300" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B77" value="&lt;b&gt;stock_reservado&lt;/b&gt;  |  &lt;b&gt;stock_reserva_fallida&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#4A5C6D;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="410" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B78" value="PASO 3a · estado = CONFIRMADA&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;publica venta_completada&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF1E4;strokeColor=#9A5709;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B79" value="PASO 3b · COMPENSACIÓN: vuelve a BORRADOR&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;saga.estado = COMPENSADA&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAEAE7;strokeColor=#A03325;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="B80" value="&lt;b&gt;venta_completada&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;facturacion · reportes · crm · caja&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#4A5C6D;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="690" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="E81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B74" target="B75">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B75" target="B76">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B76" target="B77">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E84" value="hay stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B77" target="B78">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E85" value="no hay stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B77" target="B79">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" edge="1" parent="1" source="B78" target="B80">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="B87" value="&lt;b&gt;Los dos mecanismos que hacen que esto no se pierda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Outbox&lt;/b&gt; — el evento se INSERTA en la misma transacción que la venta. Publicar después del commit significa que un RabbitMQ caído hace desaparecer el evento sin error visible en ningún lado.&lt;br&gt;&lt;b&gt;reservas_stock.expira_en&lt;/b&gt; — cubre el caso en que Ventas muera entre el paso 1 y el 3: un job libera lo apartado y nada queda bloqueado para siempre." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="790" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B88" value="&lt;b&gt;Idempotencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;RabbitMQ entrega &lt;i&gt;at-least-once&lt;/i&gt;. Si stock_reservado llega dos veces, el segundo INSERT en movimientos_inventario choca contra UNIQUE(negocio_id, idempotency_key) y el stock no se descuenta dos veces." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="400" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
