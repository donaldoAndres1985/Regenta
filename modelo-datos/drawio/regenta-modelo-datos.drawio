        <mxCell id="B171" value="&lt;b&gt;Tres mecanismos, no uno&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · Referencia lógica&lt;/b&gt;&lt;br&gt;Se guarda el UUID sin REFERENCES. En el DDL va marcada con el comentario &lt;i&gt;-- [ref lógica]&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Snapshot desnormalizado&lt;/b&gt;&lt;br&gt;Se copia lo que debe quedar inmutable. venta_lineas.nombre_snapshot, facturas.cliente_snapshot JSONB. Una factura emitida no puede cambiar porque alguien editó el cliente después.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Réplica por evento&lt;/b&gt;&lt;br&gt;Copia de solo lectura alimentada por RabbitMQ. reportes.dim_producto, con versionado SCD tipo 2." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="B172" value="&lt;b&gt;Verificado contra PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;br&gt;FKs que cruzan esquemas de servicios distintos: &lt;b&gt;0&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Por eso los 16 scripts se pueden cargar en una sola base para revisar el modelo entero, y separarlos en 15 bases —una por microservicio, como manda la arquitectura— no rompe nada." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1200" y="480" width="400" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
