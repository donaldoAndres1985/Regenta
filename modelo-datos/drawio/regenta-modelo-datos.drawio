        <mxCell id="B2783" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9A5709&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; clave primaria &amp;nbsp; &lt;font color=&quot;#0C6473&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; foránea real &amp;nbsp; &lt;font color=&quot;#1E6B45&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; única&lt;br&gt;&lt;b&gt;?&lt;/b&gt; admite NULL &amp;nbsp;&amp;nbsp; &lt;b&gt;⚙&lt;/b&gt; columna GENERATED&lt;br&gt;Línea continua = FK dentro del servicio.&lt;br&gt;Línea punteada = referencia lógica a otro servicio (sin FK física)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
