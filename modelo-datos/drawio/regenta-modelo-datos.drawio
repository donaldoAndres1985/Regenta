        <mxCell id="B125" value="&lt;b&gt;Por qué Outbox e Inbox son obligatorios en cada servicio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sin &lt;b&gt;Outbox&lt;/b&gt; no hay atomicidad entre «guardar la venta» y «publicar venta_completada»: si el broker está caído después del commit, el evento se pierde y Facturación nunca emite.&lt;br&gt;Sin &lt;b&gt;Inbox&lt;/b&gt; no hay idempotencia: AMQP entrega at-least-once, así que el mismo venta_completada puede llegar dos veces y facturar dos veces." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1200" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
