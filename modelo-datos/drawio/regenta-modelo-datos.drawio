        </mxCell>
        <mxCell id="E47" edge="1" parent="1" source="B44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4A5C6D;strokeWidth=1.6;" target="B46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="B48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9EC;strokeColor=#C9A15A;align=left;spacing=8;fontSize=10;fontColor=#4A3A15;verticalAlign=top;" value="&lt;b&gt;GARANTÍA CRÍTICA&lt;/b&gt;&lt;br&gt;Que el stock no se descuente dos veces.&lt;br&gt;Libro mayor append-only + saga +&lt;br&gt;idempotency_key en cada movimiento." vertex="1">
          <mxGeometry height="126" width="340" x="40" y="625" as="geometry" />
        </mxCell>
        <mxCell id="B49" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2F0F2;strokeColor=#0C6473;fontSize=11;fontColor=#1B2733;verticalAlign=middle;align=center;fontSize=13;" value="&lt;b&gt;Reserva&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E7183&quot;&gt;Hotel · spa · canchas · consultorios · talleres con cita&lt;/font&gt;" vertex="1">
