{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/actuator/health/readiness",
    "healthcheckTimeout": 300,
    "overlapSeconds": "30",
    "drainingSeconds": "30"
  }
}
