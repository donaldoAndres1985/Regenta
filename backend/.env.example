# Copiar a .env y cambiar los valores. El .env NO se versiona (HU-125 C4).
#
# Sirve para correr en local (docker compose up, o exportándolo antes de mvnw spring-boot:run). En
# Railway estas mismas variables se configuran en el servicio: la lista completa, con cuáles exige
# producción, está en docs/migracion/07-despliegue.md.

# desarrollo | produccion. En produccion la app no arranca si falta un secreto.
REGENTA_ENTORNO=desarrollo

# Base de datos
DB_USER=regenta
DB_PASSWORD=cambiar_en_local

# Firma de los tokens (HS256, mínimo 32 caracteres). En desarrollo, si falta, se usa una al azar.
JWT_SECRETO=cambiar_en_local_por_algo_de_al_menos_32_caracteres

# Alta de negocios por el operador de Regenta (cabecera X-Regenta-Operador).
REGENTA_OPERADOR_CLAVE=cambiar_en_local

# Bóveda del certificado de firma (HU-116): 32 bytes en base64 -> openssl rand -base64 32
BOVEDA_LLAVE_MAESTRA=

# Almacén de documentos (HU-121): el S3 local del docker-compose.
ALMACEN_TIPO=s3
ALMACEN_S3_ENDPOINT=http://localhost:9090
ALMACEN_S3_BUCKET=regenta-documentos
ALMACEN_S3_ACCESS_KEY=local
ALMACEN_S3_SECRET_KEY=local
ALMACEN_S3_CREAR_BUCKET=true

# Correo (HU-122). Sin host, el correo queda en memoria.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CORREO_REMITENTE=notificaciones@regenta.app

# Push (HU-123): la cuenta de servicio de Firebase, el JSON en una línea o en base64. Sin ella, simulado.
FCM_CREDENCIALES=

# DIAN (HU-117). Sin URL, la DIAN es simulada.
DIAN_URL=
DIAN_AMBIENTE=2
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=
