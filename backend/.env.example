# Copiar a .env y cambiar los valores. El .env NO se versiona.
#
# Estas credenciales son de desarrollo local. En Railway y en CI las variables
# se inyectan por entorno: este archivo solo documenta cuales hacen falta.

# Superusuario de PostgreSQL (solo para crear bases y roles al arrancar)
POSTGRES_USER=regenta_admin
POSTGRES_PASSWORD=cambiar_en_local

# Contrasena de los usuarios de aplicacion (reg_usuarios, reg_ventas, ...)
REGENTA_DB_PASSWORD=cambiar_en_local

# RabbitMQ
RABBIT_USER=regenta
RABBIT_PASSWORD=cambiar_en_local
