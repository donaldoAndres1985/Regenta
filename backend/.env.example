# Copiar a .env y cambiar los valores. El .env NO se versiona.
#
# Estas credenciales son de desarrollo local. En Railway y en CI las variables
# se inyectan por entorno: este archivo solo documenta cuales hacen falta.

# Superusuario de PostgreSQL (solo para crear bases y roles al arrancar)
POSTGRES_USER=regenta_admin
POSTGRES_PASSWORD=cambiar_en_local

# Contrasena de los usuarios de aplicacion (reg_usuarios, reg_ventas, ...)
REGENTA_DB_PASSWORD=cambiar_en_local

# RabbitMQ
RABBIT_USER=regenta
RABBIT_PASSWORD=cambiar_en_local

# Firma de los tokens. El gateway valida con este mismo secreto lo que emite
# servicio-usuarios, asi que tiene que ser identico en los dos. Minimo 32
# caracteres: HS256 exige una clave de 256 bits.
JWT_SECRETO=cambiar_en_local_por_algo_de_al_menos_32_caracteres
JWT_EMISOR=regenta

# Clave con la que el operador de Regenta da de alta negocios nuevos. No es de
# ningun negocio: es de Regenta. Sin ella, ese endpoint no atiende a nadie.
REGENTA_OPERADOR_CLAVE=cambiar_en_local
