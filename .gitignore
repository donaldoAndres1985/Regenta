# ============================================================================
#  Regenta — .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
#  Archivos de contexto de asistentes de IA — NUNCA se versionan
# ----------------------------------------------------------------------------
#  Son notas locales de trabajo. No forman parte del proyecto, no se comparten
#  y no deben aparecer en el historial ni en el repositorio remoto.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.cursorrules
.cursor/
.claude/
.aider*
.github/copilot-instructions.md
*.ai.md

# Carpeta que crea la app de escritorio con los archivos enviados al chat.
# Son copias de lo que ya esta en design/ y modelo-datos/.
Claude outputs/

# ----------------------------------------------------------------------------
#  Secretos y configuración local
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.p12
*.pfx
*.jks
*.keystore
*.pem
*.key
application-local.yml
application-local.properties
application-secret*.yml
# Token para crear las issues en GitHub — nunca se versiona
.github-token
.github-token.*

serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# ----------------------------------------------------------------------------
#  Flutter / Dart
# ----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
pubspec.lock
*.g.dart
*.freezed.dart
*.mocks.dart
**/doc/api/

# El esquema Drift generado SI se versiona: el CI comprueba que este al dia
# (dart run build_runner build; git diff --exit-code) en vez de regenerarlo
# en cada rama, y build_runner queda fijado por su incompatibilidad con el
# hook nativo de sqlite3 en Dart 3.10.
!app/packages/core/lib/src/local/base_local.g.dart

# melos: overrides y ficheros de IDE que genera bootstrap
.melos_tool/
pubspec_overrides.yaml
*.iml
.idea/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
*.apk
*.aab
*.keystore

# iOS / macOS (por si algún día)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/flutter_assets/
**/Flutter/App.framework

# Web
web/build/

# ----------------------------------------------------------------------------
#  Java / Spring Boot / Maven
# ----------------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!maven-wrapper.jar
!gradle-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Gradle
.gradle/
gradle-app.setting

# ----------------------------------------------------------------------------
#  Base de datos y contenedores
# ----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/
rabbitmq-data/
docker-compose.override.yml

# ----------------------------------------------------------------------------
#  IDE y editores
# ----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.settings/
.project
.classpath
.factorypath
*.sublime-workspace
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
#  Sistema operativo
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------------------------------------------------
#  Herramientas de diagramación y ofimática
# ----------------------------------------------------------------------------
# Copias de respaldo que draw.io deja al guardar
.$*.drawio.bkp
.$*.drawio.dtmp
~$*.docx
~$*.xlsx
~$*.pptx

# ----------------------------------------------------------------------------
#  Temporales del proyecto
# ----------------------------------------------------------------------------
_to_delete/
*.zip
!design/_ejemplos/*.zip
tmp/
temp/
*.log
npm-debug.log*
node_modules/
